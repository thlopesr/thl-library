# Copie para ".env" (ignorado pelo Git) e preencha. Nunca versione valores reais.
POSTMAN_API_KEY=
POSTMAN_COLLECTION_UID=2234995-062882f4-6c3a-41ff-9ace-2eaade2ca55a

# Ambiente padrao = sufixo da variavel URI-BASE-<AMBIENTE> da collection (ex.: PROJETO-INTERNO)
THL_AMBIENTE=PROJETO-INTERNO

# Opcional: se vazio, usa a autenticacao basic da propria collection
THL_USER=
THL_PASSWORD=

# Opcional: pasta da collection a validar (padrao TOTVS/Projeto/THL-Library/THL)
# THL_ESCOPO=TOTVS/Projeto/THL-Library/THL
# Opcional: false para certificado autoassinado
# THL_VERIFY_TLS=false
