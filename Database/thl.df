ADD TABLE "thl-mensagem"
  AREA "Schema Area"
  LABEL "Mensagem de integra‡Æo"
  DESCRIPTION "Tabela respons vel pelo registro principal da mensagem de integra‡Æo.
Cont‚m informa‡äes de identifica‡Æo do objeto integrado, aplica‡Æo envolvida, m‚todo, modelo de integra‡Æo, forma de execu‡Æo, destino e situa‡äes consolidadas da mensagem.
Tamb‚m armazena dados de controle operacional, como quantidade de tentativas, data de cria‡Æo, data da £ltima tentativa e n£mero do pedido de execu‡Æo, quando houver agendamento."
  DUMP-NAME "thl009"

ADD FIELD "codigo-mensagem" OF "thl-mensagem" AS character 
  DESCRIPTION "Identificador unico da mensagem de integracao, utilizado para controle, consulta, rastreabilidade e relacionamento com historico, itens e conteudos da mensagem."
  FORMAT "x(64)"
  INITIAL ""
  LABEL "Codigo Mensagem"
  POSITION 2
  MAX-WIDTH 128
  COLUMN-LABEL "Cod. Msg"
  HELP "Informe o codigo unico da mensagem."
  ORDER 10

ADD FIELD "objeto" OF "thl-mensagem" AS character 
  DESCRIPTION "Identifica o objeto de negocio relacionado a mensagem de integracao, como pedido, item, nota fiscal, cliente ou outro cadastro configurado no processo."
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Objeto"
  POSITION 3
  MAX-WIDTH 100
  COLUMN-LABEL "Objeto"
  HELP "Informe o objeto da integracao."
  ORDER 20

ADD FIELD "metodo" OF "thl-mensagem" AS integer 
  DESCRIPTION "Metodo, operacao ou acao executada pela mensagem, conforme o modelo de integracao utilizado, como verbo HTTP, operacao SOAP, comando SQL ou acao em arquivo."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Metodo"
  POSITION 5
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i02thl011.i 2}"
  COLUMN-LABEL "Metodo"
  HELP "Informe o metodo da integracao."
  ORDER 40

ADD FIELD "modelo-integracao" OF "thl-mensagem" AS integer 
  DESCRIPTION "Define o modelo tecnico utilizado pela integracao da mensagem, como REST, SOAP, Banco ou Arquivo, conforme a configuracao do processo."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Modelo Integracao"
  POSITION 7
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i03thl011.i 2}"
  COLUMN-LABEL "Mod. Integr."
  HELP "Informe o modelo da integracao."
  ORDER 60

ADD FIELD "forma-execucao" OF "thl-mensagem" AS integer 
  DESCRIPTION "Indica a forma de execucao da mensagem de integracao, como processamento online, batch ou agendado, conforme a estrategia definida para o envio ou consumo."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Forma Execucao"
  POSITION 8
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i04thl011.i 2}"
  COLUMN-LABEL "Forma Exec."
  HELP "Informe a forma de execucao."
  ORDER 70

ADD FIELD "sit-requisicao" OF "thl-mensagem" AS integer 
  DESCRIPTION "Situacao consolidada da requisicao da mensagem na ultima tentativa, permitindo identificar se a etapa de requisicao esta pendente, concluida, com erro ou nao aplicavel."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Situacao Requisicao"
  POSITION 9
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i01thl011.i 2}"
  COLUMN-LABEL "Sit. Req."
  HELP "Informe a situacao da requisicao."
  ORDER 80

ADD FIELD "sit-retorno" OF "thl-mensagem" AS integer 
  DESCRIPTION "Situacao consolidada do retorno da mensagem na ultima tentativa, permitindo identificar se houve retorno pendente, sucesso, erro ou situacao nao aplicavel."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Situacao Retorno"
  POSITION 10
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i01thl011.i 2}"
  COLUMN-LABEL "Sit. Ret."
  HELP "Informe a situacao do retorno."
  ORDER 90

ADD FIELD "sit-processamento" OF "thl-mensagem" AS integer 
  DESCRIPTION "Situacao consolidada do processamento funcional da mensagem, indicando o resultado do tratamento do conteudo pelo sistema responsavel ou processo consumidor."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Situacao Processamento"
  POSITION 11
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i01thl011.i 2}"
  COLUMN-LABEL "Sit. Proc."
  HELP "Informe a situacao do processamento."
  ORDER 100

ADD FIELD "qtd-tentativas" OF "thl-mensagem" AS integer 
  DESCRIPTION "Quantidade total de tentativas ja realizadas para a mensagem de integracao, considerando execucoes normais, reenvios e reprocessamentos."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Qtde Tentativas"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "Tentativas"
  HELP "Informe a quantidade de tentativas."
  ORDER 110

ADD FIELD "dt-criacao" OF "thl-mensagem" AS datetime 
  DESCRIPTION "Data de criacao da mensagem de integracao no sistema, utilizada para controle temporal, rastreabilidade e acompanhamento do ciclo de vida do registro."
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Data Criacao"
  POSITION 13
  MAX-WIDTH 8
  COLUMN-LABEL "Dt. Criacao"
  HELP "Informe a data de criacao."
  ORDER 120

ADD FIELD "dt-integracao" OF "thl-mensagem" AS datetime 
  DESCRIPTION "Data da ultima tentativa de integracao da mensagem, independentemente do resultado, utilizada para monitoramento operacional e controle de reprocessamento."
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Data Integra‡Æo"
  POSITION 14
  MAX-WIDTH 8
  COLUMN-LABEL "Dt. Integra‡Æo"
  HELP "Informe a data da ultima tentativa."
  ORDER 130

ADD FIELD "destino" OF "thl-mensagem" AS character 
  DESCRIPTION "Identifica o destino tecnico utilizado pela mensagem, como URL, endpoint, instancia de banco, diretorio, arquivo ou outro caminho de comunicacao."
  FORMAT "x(200)"
  INITIAL ""
  LABEL "Destino"
  POSITION 15
  MAX-WIDTH 220
  COLUMN-LABEL "Destino"
  HELP "Informe o destino da mensagem."
  ORDER 140

ADD FIELD "num-ped-exec" OF "thl-mensagem" AS integer 
  DESCRIPTION "Numero do pedido de execucao associado a mensagem quando o processamento ocorrer por agendamento, permitindo rastrear a execucao programada."
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "Pedido Execucao"
  POSITION 16
  MAX-WIDTH 4
  COLUMN-LABEL "Ped. Exec."
  HELP "Informe o pedido de execucao."
  ORDER 150

ADD FIELD "sentido-fluxo" OF "thl-mensagem" AS logical 
  DESCRIPTION "Indica o sentido do fluxo da mensagem de integracao, identificando se a mensagem e de entrada ou de saida do ERP."
  FORMAT "Sa¡da/Entrada"
  INITIAL "Sa¡da"
  LABEL "Sentido Fluxo"
  POSITION 17
  MAX-WIDTH 1
  COLUMN-LABEL "Sentido"
  HELP "Informe o sentido do fluxo."
  ORDER 50

ADD FIELD "cod-status-retorno" OF "thl-mensagem" AS integer 
  DESCRIPTION "Codigo tecnico de status do retorno da tentativa de integracao, utilizado para identificar o resultado retornado pelo servico, aplicacao ou processo executado."
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Codigo Status Retorno"
  POSITION 18
  MAX-WIDTH 4
  COLUMN-LABEL "Cod. Status Ret"
  HELP "Informe o codigo do status de retorno."
  ORDER 160

ADD FIELD "descr-retorno" OF "thl-mensagem" AS character 
  DESCRIPTION "Descricao resumida do retorno da tentativa de integracao, utilizada para apresentar o resultado tecnico retornado pelo servico, aplicacao ou processo."
  FORMAT "x(200)"
  INITIAL ""
  LABEL "Descricao Retorno"
  POSITION 19
  MAX-WIDTH 400
  COLUMN-LABEL "Descr. Retorno"
  HELP "Informe a descricao do retorno."
  ORDER 170

ADD FIELD "operacao" OF "thl-mensagem" AS character 
  DESCRIPTION "Identifica a operacao configurada para o objeto de integracao, representando a acao funcional ou tecnica executada no processo, independentemente da tecnologia utilizada."
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Operacao"
  POSITION 20
  MAX-WIDTH 120
  COLUMN-LABEL "Operacao"
  HELP "Informe a operacao da integracao."
  ORDER 180

ADD INDEX "ind-objeto-parametro" ON "thl-mensagem" 
  AREA "Schema Area"
  PRIMARY
  INDEX-FIELD "objeto" ASCENDING 
  INDEX-FIELD "operacao" ASCENDING 

ADD INDEX "ch-mensagem" ON "thl-mensagem" 
  AREA "Schema Area"
  UNIQUE
  INDEX-FIELD "codigo-mensagem" ASCENDING 

ADD INDEX "ind-objeto" ON "thl-mensagem" 
  AREA "Schema Area"
  INDEX-FIELD "objeto" ASCENDING 

ADD TABLE "thl-mensagem-conteudo"
  AREA "Schema Area"
  LABEL "Conteudo da Mensagem"
  DESCRIPTION "Armazena os conteudos trafegados pela mensagem de integracao, como requisicao e retorno, permitindo guardar payloads tecnicos para auditoria e analise."
  DUMP-NAME "thl016"

ADD FIELD "codigo-mensagem" OF "thl-mensagem-conteudo" AS character 
  DESCRIPTION "Identificador unico da mensagem de integracao, utilizado para controle, consulta, rastreabilidade e relacionamento com historico, itens e conteudos da mensagem."
  FORMAT "x(64)"
  INITIAL ""
  LABEL "Codigo Mensagem"
  POSITION 2
  MAX-WIDTH 128
  COLUMN-LABEL "Cod. Msg"
  HELP "Informe o codigo unico da mensagem."
  ORDER 10

ADD FIELD "tipo-conteudo" OF "thl-mensagem-conteudo" AS integer 
  DESCRIPTION "Tipo do conteudo armazenado para a mensagem, como requisicao, retorno ou outro conteudo tecnico previsto no processo de integracao."
  FORMAT ">9"
  INITIAL "0"
  LABEL "Tipo Conteudo"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Tipo Cont."
  HELP "Informe o tipo do conteudo."
  ORDER 20

ADD FIELD "conteudo" OF "thl-mensagem-conteudo" AS clob 
  DESCRIPTION "Conteudo tecnico trafegado pela mensagem de integracao, armazenando payloads como JSON, XML, texto ou outras estruturas utilizadas no intercambio"
