ADD TABLE "thl-mensagem-historico"
  AREA "Schema Area"
  LABEL "Hist¢rico Mensagem"
  DESCRIPTION "Armazena o historico de tentativas da mensagem de integracao, registrando datas, destino e situacoes da execucao para rastreabilidade e reprocessamento."
  DUMP-NAME "thl008"

ADD FIELD "tentativa" OF "thl-mensagem-historico" AS integer 
  DESCRIPTION "Numero sequencial da tentativa registrada para a mensagem, utilizado para controle de reenvio, reprocessamento e rastreabilidade da execucao."
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Tentativa"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Tentativa"
  HELP "Informe o numero da tentativa."
  ORDER 20

ADD FIELD "sit-requisicao" OF "thl-mensagem-historico" AS integer 
  DESCRIPTION "Situacao consolidada da requisicao da mensagem na ultima tentativa, permitindo identificar se a etapa de requisicao esta pendente, concluida, com erro ou nao aplicavel."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Situacao Requisicao"
  POSITION 9
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i01thl011.i 2}"
  COLUMN-LABEL "Sit. Req."
  HELP "Informe a situacao da requisicao."
  ORDER 30

ADD FIELD "sit-retorno" OF "thl-mensagem-historico" AS integer 
  DESCRIPTION "Situacao consolidada do retorno da mensagem na ultima tentativa, permitindo identificar se houve retorno pendente, sucesso, erro ou situacao nao aplicavel."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Situacao Retorno"
  POSITION 10
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i01thl011.i 2}"
  COLUMN-LABEL "Sit. Ret."
  HELP "Informe a situacao do retorno."
  ORDER 40

ADD FIELD "sit-processamento" OF "thl-mensagem-historico" AS integer 
  DESCRIPTION "Situacao consolidada do processamento funcional da mensagem, indicando o resultado do tratamento do conteudo pelo sistema responsavel ou processo consumidor."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Situacao Processamento"
  POSITION 11
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set horizontal radio-buttons {thl\include\i01thl011.i 2}"
  COLUMN-LABEL "Sit. Proc."
  HELP "Informe a situacao do processamento."
  ORDER 50

ADD FIELD "codigo-mensagem" OF "thl-mensagem-historico" AS character 
  DESCRIPTION "Identificador unico da mensagem de integracao, utilizado para controle, consulta, rastreabilidade e relacionamento com historico, itens e conteudos da mensagem."
  FORMAT "x(64)"
  INITIAL ""
  LABEL "Codigo Mensagem"
  POSITION 12
  MAX-WIDTH 128
  COLUMN-LABEL "Cod. Msg"
  HELP "Informe o codigo unico da mensagem."
  ORDER 10

ADD FIELD "dt-criacao" OF "thl-mensagem-historico" AS datetime 
  DESCRIPTION "Data de criacao da mensagem de integracao no sistema, utilizada para controle temporal, rastreabilidade e acompanhamento do ciclo de vida do registro."
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Data Criacao"
  POSITION 13
  MAX-WIDTH 8
  COLUMN-LABEL "Dt. Criacao"
  HELP "Informe a data de criacao."
  ORDER 60

ADD FIELD "dt-integracao" OF "thl-mensagem-historico" AS datetime 
  DESCRIPTION "Data da ultima tentativa de integracao da mensagem, independentemente do resultado, utilizada para monitoramento operacional e controle de reprocessamento."
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Data Integra‡Æo"
  POSITION 14
  MAX-WIDTH 8
  COLUMN-LABEL "Dt. Integra‡Æo"
  HELP "Informe a data da ultima tentativa."
  ORDER 70

ADD FIELD "destino" OF "thl-mensagem-historico" AS character 
  DESCRIPTION "Identifica o destino tecnico utilizado pela mensagem, como URL, endpoint, instancia de banco, diretorio, arquivo ou outro caminho de comunicacao."
  FORMAT "x(200)"
  INITIAL ""
  LABEL "Destino"
  POSITION 15
  MAX-WIDTH 220
  COLUMN-LABEL "Destino"
  HELP "Informe o destino da mensagem."
  ORDER 80

ADD FIELD "cod-status-retorno" OF "thl-mensagem-historico" AS integer 
  DESCRIPTION "Codigo tecnico de status do retorno da tentativa de integracao, utilizado para identificar o resultado retornado pelo servico, aplicacao ou processo executado."
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Codigo Status Retorno"
  POSITION 21
  MAX-WIDTH 4
  COLUMN-LABEL "Cod. Status Ret"
  HELP "Informe o codigo do status de retorno."
  ORDER 90

ADD FIELD "descr-retorno" OF "thl-mensagem-historico" AS character 
  DESCRIPTION "Descricao resumida do retorno da tentativa de integracao, utilizada para apresentar o resultado tecnico retornado pelo servico, aplicacao ou processo."
  FORMAT "x(200)"
  INITIAL ""
  LABEL "Descricao Retorno"
  POSITION 22
  MAX-WIDTH 400
  COLUMN-LABEL "Descr. Retorno"
  HELP "Informe a descricao do retorno."
  ORDER 100

