&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-record V-table-Win 
PROCEDURE local-assign-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

    /* Code placed here will execute PRIOR to standard behavior. */
    run pi-validate.
    if return-value = 'ADM-ERROR':U then
        return 'ADM-ERROR':U.
    
    /*:T Ponha na pi-validate todas as validacoes */
    /*:T Nao gravar nada no registro antes do dispatch do assign-record e 
       nem na PI-validate. */
    
    /* Dispatch standard ADM method.                             */
    RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-record':U ) .
    if RETURN-VALUE = 'ADM-ERROR':U then 
        return 'ADM-ERROR':U.
    
    /*:T Todos os assign's nao feitos pelo assign-record devem ser feitos aqui */  
    /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-delete-record V-table-Win
PROCEDURE local-delete-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       Eliminar o ambiente elimina tambem as variaveis de parametro dele
               (thl0002b), na mesma transacao.
------------------------------------------------------------------------------*/
    define variable c-ambiente as character no-undo.

    /* Code placed here will execute PRIOR to standard behavior. */
    if available thl-ambiente then
        assign c-ambiente = thl-ambiente.cod-ambiente.

    do transaction on error undo, return 'ADM-ERROR':U:

        /* Dispatch standard ADM method.                             */
        RUN dispatch IN THIS-PROCEDURE ( INPUT 'delete-record':U ) .
        if RETURN-VALUE = 'ADM-ERROR':U then
            undo, return 'ADM-ERROR':U.

        /* filhos do registro eliminado */
        if c-ambiente <> "" then do:
            for each thl-ambiente-param-variavel exclusive-lock
                where thl-ambiente-param-variavel.cod-ambiente = c-ambiente:
                delete thl-ambiente-param-variavel.
            end.
        end.

    end.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

