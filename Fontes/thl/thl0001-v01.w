&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE Pi-validate V-table-Win 
PROCEDURE Pi-validate :
/*:T------------------------------------------------------------------------------
  Purpose:Validar a viewer     
  Parameters:  <none>
  Notes: Nao fazer assign aqui. Nesta procedure
  devem ser colocadas apenas validacoes, pois neste ponto do programa o registro 
  ainda nao foi criado.       
------------------------------------------------------------------------------*/
    {include/i-vldfrm.i} /*:T Validacao de dicionario */
    

    if adm-new-record then do:
        if input frame {&frame-name} thl-ambiente.cod-ambiente = "" then do:
            {include/i-vldprg.i}
            run utp/ut-msgs.p (input "show":U, input 17006,
                               input "Ambiente nao informado~~Informe o codigo do ambiente.").
            apply "entry":U to thl-ambiente.cod-ambiente in frame {&frame-name}.
            return "ADM-ERROR":U.
        end.
        if can-find(thl-ambiente where thl-ambiente.cod-ambiente = input frame {&frame-name} thl-ambiente.cod-ambiente) then do:
            {include/i-vldprg.i}
            run utp/ut-msgs.p (input "show":U, input 17006,
                               input "Ambiente ja cadastrado~~Informe outro codigo.").
            apply "entry":U to thl-ambiente.cod-ambiente in frame {&frame-name}.
            return "ADM-ERROR":U.
        end.
    end.
    if input frame {&frame-name} thl-ambiente.ip = "" then do:
        {include/i-vldprg.i}
        run utp/ut-msgs.p (input "show":U, input 17006,
                           input "IP nao informado~~Informe o IP (ou trecho) que identifica o ambiente no PROPATH.").
        apply "entry":U to thl-ambiente.ip in frame {&frame-name}.
        return "ADM-ERROR":U.
    end.
    /* o ambiente corrente e resolvido pelo IP: nao pode repetir */
    if can-find(first thl-ambiente where thl-ambiente.ip = input frame {&frame-name} thl-ambiente.ip
                        and thl-ambiente.cod-ambiente <> input frame {&frame-name} thl-ambiente.cod-ambiente) then do:
        {include/i-vldprg.i}
        run utp/ut-msgs.p (input "show":U, input 17006,
                           input "IP ja usado por outro ambiente~~Cada ambiente precisa de um IP proprio: o ambiente corrente e resolvido pelo IP no PROPATH.").
        apply "entry":U to thl-ambiente.ip in frame {&frame-name}.
        return "ADM-ERROR":U.
    end.

/*:T    Segue um exemplo de validacao de programa */
/*       find tabela where tabela.campo1 = c-variavel and               */
/*                         tabela.campo2 > i-variavel no-lock no-error. */
      
      /*:T Este include deve ser colocado sempre antes do ut-msgs.p */
/*       {include/i-vldprg.i}                                             */
/*       run utp/ut-msgs.p (input "show":U, input 7, input return-value). */
/*       return 'ADM-ERROR':U.                                            */

END PROCEDURE.

